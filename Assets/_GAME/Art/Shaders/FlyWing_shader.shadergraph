{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "cf3aa610def6438ea4ecd19fa0a4c07b",
    "m_Group": {
        "m_Id": "8efde7c82c10496eb65d8934787255ab"
    },
    "m_Name": "AdditionalLightTest (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -6902.66650390625,
            "y": 6.6666412353515629,
            "width": 265.33349609375,
            "height": 167.99978637695313
        }
    },
    "m_Slots": [
        {
            "m_Id": "8db022d606564cd8a911a3add0706e8e"
        },
        {
            "m_Id": "ceaa955a32a24b31933be7d50be97345"
        },
        {
            "m_Id": "20d6e7922a4245c097e5280cba502d59"
        },
        {
            "m_Id": "be535b2372f44d1da7cf232cb261d848"
        },
        {
            "m_Id": "a707729a0b9a4119bebeeb68f4eaeec9"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "AdditionalLightTest",
    "m_FunctionSource": "b85b2424fedb5544db75eae5b746590c",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Color = 0.0f;\r\n\r\n#ifndef SHADERGRAPH_PREVIEW\r\n    \r\n    uint pixelLightCount = GetAdditionalLightsCount();\r\n\r\n    #if USE_FORWARD_PLUS\r\n        InputData inputData = (InputData)0;\r\n        inputData.normalizedScreenSpaceUV = ScreenPosition;\r\n        inputData.positionWS = WorldPosition;\r\n    #endif\r\n\r\n    LIGHT_LOOP_BEGIN(pixelLightCount)\r\n        #if !USE_FORWARD_PLUS\r\n            lightIndex = GetPerObjectLightIndex(lightIndex);\r\n        #endif\r\n        Light light = GetAdditionalPerObjectLight(lightIndex, WorldPosition);\r\n        float NdotL = saturate((dot(Normal, light.direction) + Wrap) / 2*Wrap);\n        Color += light.color * light.distanceAttenuation * NdotL;\n        \r\n    LIGHT_LOOP_END\r\n#endif"
}

