    },
    "m_Name": "AdditionalLightTest (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3584.6669921875,
            "y": 100.666748046875,
