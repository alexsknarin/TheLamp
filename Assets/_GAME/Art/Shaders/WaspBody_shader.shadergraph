{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b41ebed083ef4f8b93a3eab6365a0134",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "EyeSpecualr (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3576.00048828125,
            "y": 594.666748046875,
            "width": 256.666748046875,
            "height": 240.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "59947d4bfe5443e6895a5931e76e0658"
        },
        {
            "m_Id": "76624ac8db414eef8d25cc5506a410a2"
        },
        {
            "m_Id": "e997f80f438841bdbbb2e26b46ac3d76"
        },
        {
            "m_Id": "5fe32feabdbb4fa891eeb78dc341c24b"
        },
        {
            "m_Id": "eada9d88b9ea4704b9123deff2cb4417"
        },
        {
            "m_Id": "5e89c76f05c24a61b1d37cf7183ecca7"
        },
        {
            "m_Id": "3830ac20e53d44dbb0129aaac7a970f3"
        },
        {
            "m_Id": "7522d3dd163d45f0a3e666685ab70e4e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "EyeSpecualr",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "EyeSpecular = 0.0f;\r\n\r\n#ifndef SHADERGRAPH_PREVIEW\r\n    \r\n    uint pixelLightCount = GetAdditionalLightsCount();\r\n\r\n    #if USE_FORWARD_PLUS\r\n        InputData inputData = (InputData)0;\r\n        inputData.normalizedScreenSpaceUV = ScreenPosition;\r\n        inputData.positionWS = WorldPosition;\r\n    #endif\r\n\r\n    LIGHT_LOOP_BEGIN(pixelLightCount)\r\n        #if !USE_FORWARD_PLUS\r\n            lightIndex = GetPerObjectLightIndex(lightIndex);\r\n        #endif\r\n        // Diffuse\r\n        Light light = GetAdditionalPerObjectLight(lightIndex, WorldPosition);\r\n        // Phong Specular\r\n        float3 V = normalize(CameraPosition - WorldPosition);\r\n        float3 H = normalize(light.direction + V);\r\n        float NdotH = dot(Normal, H);\r\n\r\n        float EyeSpecBase = saturate((NdotH + EyeWrap)/2*EyeWrap);\r\n        float EyeRetroMask = saturate(1-NdotH);\r\n        EyeSpecular += light.color * pow(EyeSpecBase, EyePower) * light.distanceAttenuation * pow(EyeRetroMask, EyeSpotPower); \r\n \r\n        \r\n    LIGHT_LOOP_END\r\n#endif\n"
}

