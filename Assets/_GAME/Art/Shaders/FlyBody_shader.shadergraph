{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "8f9fb18a377548e4bffbb445d165a89b",
    "m_Group": {
        "m_Id": "c7db7631f03f41be9b71df284424f7a0"
    },
    "m_Name": "AdditionalLightTest (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -6932.66748046875,
            "y": 2931.333740234375,
            "width": 271.33349609375,
            "height": 312.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "0d1c5fed2fbc4d70a5f28fb77c7d46c6"
        },
        {
            "m_Id": "f95c392be2db4c8ab741a96d7a6524df"
        },
        {
            "m_Id": "368b9d63f5744fdc98b809fc4b9c6b26"
        },
        {
            "m_Id": "67f19c2752c84fc6901f36f1007fa35b"
        },
        {
            "m_Id": "a6fbd1d36a64487db2eef5916fd1c75f"
        },
        {
            "m_Id": "f3b892f35a1447e380e133b291cff9e3"
        },
        {
            "m_Id": "c04d47f1d0fe4526a65b09b40311e287"
        },
        {
            "m_Id": "8a953eed1f5047589133aeca8d3d4d64"
        },
        {
            "m_Id": "5d94028c03dc4d58aac7823e69357c01"
        },
        {
            "m_Id": "bccfa357e31f4a33a06c17f779435a61"
        },
        {
            "m_Id": "b5878742160e4a00aa5fcab26422c2ca"
        },
        {
            "m_Id": "e709f16fbd634a089a47cc8a14e3d73e"
        },
        {
            "m_Id": "8d95d7bd0b354cb09eb33f2d895cf198"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "AdditionalLightTest",
    "m_FunctionSource": "b85b2424fedb5544db75eae5b746590c",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "DiffuseColor = 0.0f;\r\nPhongSpecular = 0.0f;\r\nEyeSpecular = 0.0f;\r\n\r\n#ifndef SHADERGRAPH_PREVIEW\r\n    \r\n    uint pixelLightCount = GetAdditionalLightsCount();\r\n\r\n    #if USE_FORWARD_PLUS\r\n        InputData inputData = (InputData)0;\r\n        inputData.normalizedScreenSpaceUV = ScreenPosition;\r\n        inputData.positionWS = WorldPosition;\r\n    #endif\r\n\r\n    LIGHT_LOOP_BEGIN(pixelLightCount)\r\n        #if !USE_FORWARD_PLUS\r\n            lightIndex = GetPerObjectLightIndex(lightIndex);\r\n        #endif\r\n        // Diffuse\r\n        Light light = GetAdditionalPerObjectLight(lightIndex, WorldPosition);\r\n        float NdotL = saturate((dot(Normal, light.direction) + Wrap) / 2*Wrap);\r\n        DiffuseColor += light.color * light.distanceAttenuation * NdotL;\r\n        // Phong Specular\r\n        float3 V = normalize(CameraPosition - WorldPosition);\r\n        float3 H = normalize(light.direction + V);\r\n        float NdotH = dot(Normal, H);\r\n        float PhongSpecBase = saturate((NdotH + PhongWrap)/2*PhongWrap );\r\n        PhongSpecular += light.color * pow(PhongSpecBase, PhongPower) * light.distanceAttenuation;\r\n        //\r\n        float EyeSpecBase = saturate((NdotH + EyeWrap)/2*EyeWrap);\r\n        float EyeRetroMask = saturate(1-NdotH);\r\n        EyeSpecular += light.color * pow(EyeSpecBase, EyePower) * light.distanceAttenuation * pow(EyeRetroMask, EyeSpotPower); \r\n \r\n        \r\n    LIGHT_LOOP_END\r\n#endif"
}

