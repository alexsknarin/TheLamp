    },
    "m_Name": "AdditionalLightTest (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -4870.66650390625,
            "y": -1194.666748046875,
            "width": 265.33349609375,
            "height": 192.00006103515626
        }
    },
    "m_Slots": [
        {
            "m_Id": "d439ee346fd240e1ace0e74b81931f82"
        },
        {
            "m_Id": "b2f8017614014f78a697555fc25fc2e6"
        },
        {
            "m_Id": "a5712daf639b46a7ae7a42b3618da648"
        },
        {
            "m_Id": "e386d6713f314fff96e0126c50e80a42"
        },
        {
            "m_Id": "1a7ad8bd3260408aaee2b7b060769eba"
        },
        {
            "m_Id": "0f2756a7376b42c3a8416542ddeda424"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "AdditionalLightTest",
    "m_FunctionSource": "b85b2424fedb5544db75eae5b746590c",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Color = 0.0f;\r\n\r\n#ifndef SHADERGRAPH_PREVIEW\r\n    \r\n    uint pixelLightCount = GetAdditionalLightsCount();\r\n\r\n    #if USE_FORWARD_PLUS\r\n        InputData inputData = (InputData)0;\r\n        inputData.normalizedScreenSpaceUV = ScreenPosition;\r\n        inputData.positionWS = WorldPosition;\r\n    #endif\r\n\r\n    LIGHT_LOOP_BEGIN(pixelLightCount)\r\n        #if !USE_FORWARD_PLUS\r\n            lightIndex = GetPerObjectLightIndex(lightIndex);\r\n        #endif\r\n        Light light = GetAdditionalPerObjectLight(lightIndex, WorldPosition);\r\n        float NdotL = saturate((dot(Normal, light.direction) + Wrap) / 2*Wrap);\n        NdotL = pow(NdotL, TPower);\n        Color += light.color * light.distanceAttenuation * NdotL;\n        \r\n    LIGHT_LOOP_END\r\n#endif"
}

