{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "fd20de37594e41708205403d8cbbdc0c",
    "m_Group": {
        "m_Id": "01bc3246601e494bb2770d03c103e214"
    },
    "m_Name": "AnisotropicSpecular (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -3563.333251953125,
            "y": -1664.66650390625,
            "width": 269.999755859375,
            "height": 264.0001220703125
        }
    },
    "m_Slots": [
        {
            "m_Id": "bf8cbe7a84ff4ba0bd6b005613ce79de"
        },
        {
            "m_Id": "46726dcd410e410fb772f89c1128edcd"
        },
        {
            "m_Id": "eda2880e2e0c4cb48c56ba1200874ba9"
        },
        {
            "m_Id": "04abdbe7707940b4ad74126c72677d36"
        },
        {
            "m_Id": "8adb90a68d1a4745984521297418aa3a"
        },
        {
            "m_Id": "19d06a1392b94b91a16ca66f2413e4a1"
        },
        {
            "m_Id": "7e1f85ee355c49e5954a192a144c97a6"
        },
        {
            "m_Id": "517b4ed92cf246c58119b6706065ffde"
        },
        {
            "m_Id": "d72fd077396245ba8be50bb44e8203ea"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "AnisotropicSpecular",
    "m_FunctionSource": "a2b6d8fd15e2f5d438540b6fb40be6b9",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float AnisoSpecular(float3 T, float3 V, float3 L, float exponent)\r\n{\r\n    float3 H = normalize(L + V);\r\n    float dotTH = dot(T, H);\r\n    float sinTH = sqrt(1.0 - dotTH*dotTH);\r\n    float dirAtten = smoothstep(-1.0, 0.0, dot(T, H));\r\n    return dirAtten * pow(sinTH, exponent);\r\n}\n\n//OutColor = 0.5f;\r\n\r\n#ifndef SHADERGRAPH_PREVIEW\r\n    \r\n    uint pixelLightCount = GetAdditionalLightsCount();\r\n\r\n    #if USE_FORWARD_PLUS\r\n        InputData inputData = (InputData)0;\r\n        inputData.normalizedScreenSpaceUV = ScreenPosition;\r\n        inputData.positionWS = WorldPosition;\r\n    #endif\r\n\r\n    LIGHT_LOOP_BEGIN(pixelLightCount)\r\n        #if !USE_FORWARD_PLUS\r\n            lightIndex = GetPerObjectLightIndex(lightIndex);\r\n        #endif\r\n        // Diffuse\r\n        Light light = GetAdditionalPerObjectLight(lightIndex, WorldPosition);\r\n\t\t\r\n        float NdotL = dot(Normal, light.direction);\r\n\r\n        // Phong Specular\r\n        float3 V = normalize(CameraPosition - WorldPosition);\r\n        float3 H = normalize(light.direction + V);\r\n \n       //float NdotH = dot(Normal, H);\n       float dotTH = dot(Tangent, H);\n       float sinTH = sin(1.0 - dotTH*dotTH);\n\n\r        OutColor += light.color * pow(sinTH, PhongPower) * light.distanceAttenuation;\n\n        \r\n    LIGHT_LOOP_END\r\n#endif"
}

