    },
    "m_Name": "AdditionalLightTest (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -8040.6669921875,
            "y": -925.9998168945313,
